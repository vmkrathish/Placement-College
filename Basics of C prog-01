#include <stdio.h>

int main() {
    // Size of the datatype
  
    int a = 5;
    float b = 2.2;
    double c = 2.3;
    
    printf("int: %d\nfloat: %d\ndouble: %d", sizeof(a),sizeof(b),sizeof(c));

    return 0;
    
    //Addition of 2 nos
    int a, b, c;
    printf("Enter two nos. for addition:");
